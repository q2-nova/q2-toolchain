#!/bin/sh
# C compiler of the X2000 toolchain (tools/x2000_toolchain.py) for Q2
# userspace: clang with CPU x2000 and MSA, the SDK's sysroot, and the SDK's
# GCC for start files, libgcc and the linker. The ABI flags are the SDK's
# (FP64, NaN-2008, abs-2008).
#   Q2_X2000_CLANG  install/llvm/bin/clang   (x2000_toolchain.py shell-env)
#   Q2_SDK          the Buildroot host directory (rig input `sdk`)
#   Q2_X2000_CC_ARCH  optional: the CPU flags instead of the default
#                   `-march=x2000 -mmsa`, e.g. `-march=mips32r5 -mmsa
#                   -Xclang -target-feature -Xclang +x2000` (costs and
#                   lowering, generic scheduling) or `-march=mips32r2`
#                   (clang without any X2000 change)
#
# The flags Buildroot's GCC wrapper adds (toolchain/toolchain-wrapper.c and
# .mk of the SDK's Buildroot 2026.08.1, configured BR2_SSP_STRONG,
# BR2_RELRO_FULL, BR2_PIC_PIE, BR2_REPRODUCIBLE), with its conditions, before
# the caller's arguments, so a package's own -fno-stack-protector or
# -Wl,--build-id still wins as it does with GCC:
#   -fstack-protector-strong; -ffile-prefix-map=/work/build/os/out=buildroot
#   (the wrapper's BASE_DIR, the build container's path);
#   when an input file is named: -Wl,--build-id=none, -Wl,-z,now, -Wl,-z,relro
#   (not with -D__KERNEL__ or -D__UBOOT__);
#   unless -r, -Wl,-r, -static, -D__KERNEL__, -D__UBOOT__, -fno-pie,
#   -fno-PIE or -no-pie: -fPIE when no -fpie/-fPIE/-fpic/-fPIC is given, and
#   -pie when not -shared.
# _FORTIFY_SOURCE is not the wrapper's: it comes with Buildroot's
# TARGET_CFLAGS, which each package passes to both compilers.
# os/x2000-c-build.py checks this list against the SDK's wrapper.
input=0 shared=0 pie=1 pic=0 kernel=0
for a in "$@"; do
  case "$a" in
    -D__KERNEL__|-D__UBOOT__) pie=0 kernel=1 ;;
    -r|-Wl,-r|-static|-fno-pie|-fno-PIE|-no-pie) pie=0 ;;
    -shared) shared=1 ;;
    -fpie|-fPIE|-fpic|-fPIC) pic=1 ;;
    -*) ;;
    *) input=1 ;;
  esac
done
set -- -fstack-protector-strong -ffile-prefix-map=/work/build/os/out=buildroot "$@"
if [ $input = 1 ]; then
  set -- -Wl,--build-id=none "$@"
fi
if [ $pie = 1 ]; then
  [ $shared = 1 ] || set -- -pie "$@"
  [ $pic = 1 ] || set -- -fPIE "$@"
fi
if [ $input = 1 ] && [ $kernel = 0 ]; then
  set -- -Wl,-z,now -Wl,-z,relro "$@"
fi
: "${Q2_X2000_CLANG:?run: eval \"\$(python3 tools/x2000_toolchain.py shell-env)\"}"
: "${Q2_SDK:?set Q2_SDK to the Buildroot host directory}"
exec "$Q2_X2000_CLANG" --target=mipsel-buildroot-linux-gnu \
  --sysroot="$Q2_SDK/mipsel-buildroot-linux-gnu/sysroot" --gcc-toolchain="$Q2_SDK" \
  ${Q2_X2000_CC_ARCH:--march=x2000 -mmsa} -mfp64 -mnan=2008 -mabs=2008 -mabicalls -fuse-ld=bfd \
  -Wno-unused-command-line-argument "$@"
